[alias]
  a = add
  b = branch
  c = commit
  ca = commit --amend
  cm = commit -m
  cl = clone --recurse-submodules
  co = checkout
  cob = checkout -b
  cp = cherry-pick
  d = diff
  dc = diff --cached
  f = fetch
  fo = fetch origin
  i = init
  l = log --all --decorate --oneline --graph
  ln = log --all --decorate --oneline --graph --name-only
  m = merge
  p = push
  pf = push --force-with-lease
  pu = !git push -u origin $(git rev-parse --abbrev-ref HEAD)
  r = remote
  rv = remote -v
  rb = rebase
  rbi = rebase -i
  rba = rebase --abort
  rbc = rebase --continue
  re = reset
  reh = reset --hard
  res = reset --soft
  rl = reflog
  s = status
  sh = show
  sm = submodule
  sma = submodule add
  smr = submodule update --init --recursive
  st = stash
  sw = switch
